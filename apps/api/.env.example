# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jscraft_db?schema=public"

# ─── Redis (optional — for caching) ─────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── JWT Secrets — generate with: openssl rand -hex 64 ───────────────────────
JWT_ACCESS_SECRET="replace-with-64-char-random-string-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
JWT_REFRESH_SECRET="replace-with-different-64-char-random-string-xxxxxxxxxxxxxxxxxxxxx"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# ─── Server & Proxy ──────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3000
FRONTEND_URL="http://localhost:5173"
# Comma-separated list of additional allowed origins for CORS / CSRF checks:
ALLOWED_ORIGINS="http://localhost:5173"
# Express trust proxy setting:
# Set to 'false' in local development.
# On Railway / reverse proxy with 1 hop, set TRUST_PROXY="1" so req.ip uses client IP.
TRUST_PROXY="false"
# Grace window in seconds for refresh token rotation race conditions:
REFRESH_TOKEN_GRACE_SECONDS=15

# ─── Email (Resend / SMTP) ───────────────────────────────────────────────────
SMTP_HOST="smtp.resend.com"
SMTP_PORT=465
SMTP_USER="resend"
SMTP_PASS="re_your_api_key"
SMTP_FROM="noreply@jscraft.dev"

# ─── Cloudinary (avatar uploads) ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Anthropic AI ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""

# ─── Security ────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Cron Jobs ────────────────────────────────────────────────────────────────
# Set to 'false' in multi-instance deployments so only 1 instance runs scheduled jobs
ENABLE_CRON="true"
